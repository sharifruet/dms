# Copy to .env and it runs: every value needed for a local stack is filled in below.
# Compose reads .env automatically, and .env is gitignored.
#
#     cp .env.example .env && docker compose up -d --build

# ---------------------------------------------------------------- JWT signing key
#
# The value below is a working LOCAL DEVELOPMENT key. It is in the repository, which
# means it is public, which means it is not a secret — it is here so that a fresh clone
# starts without a setup step.
#
# NEVER USE IT ANYWHERE REAL. Anyone who can read this file can mint a token for any
# user, administrators included; that is precisely the hole the security review closed
# when it took the old hard-coded key out of application.properties. Staging and
# production must set JWT_SECRET in their own environment, from:
#
#     openssl rand -base64 48
#
# HMAC-SHA256 needs at least 32 bytes and the application refuses to start with less.
JWT_SECRET=local-development-only-do-not-use-in-any-real-environment-8f3c1a

# ------------------------------------------------------------------ Outbound mail
#
# Host, port, sender and username are not secrets and are the values the application
# has always used. The password is one: it was committed in plain text in
# docker-compose.full.yml, and it needs rotating and putting here rather than there.
#
# Leaving MAIL_PASSWORD empty is fine for local work — nothing in the procurement
# lifecycle requires outbound mail, and notifications are still written in-app.
MAIL_HOST=mail.i2gether.com
MAIL_PORT=465
MAIL_USERNAME=easyops@i2gether.com
MAIL_PASSWORD=
EMAIL_FROM=easyops@i2gether.com
