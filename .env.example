# Copy to .env and fill in. Compose reads .env automatically; it is gitignored.

# JWT signing key. HMAC-SHA256 needs at least 32 bytes, and the application refuses to
# start with anything shorter or with nothing at all - a missing key that quietly falls
# back to a default is the same vulnerability wearing a different hat.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Outbound mail. Previously committed in docker-compose.full.yml in plain text.
MAIL_HOST=mail.i2gether.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_FROM=
