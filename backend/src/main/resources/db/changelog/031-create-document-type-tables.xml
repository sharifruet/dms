            </column>
            <column name="contract_number" type="VARCHAR(100)"/>
            <column name="vendor_name" type="VARCHAR(255)"/>
            <column name="contract_date" type="DATE"/>
            <column name="contract_amount" type="NUMERIC(18,2)"/>
            <column name="validity_period" type="VARCHAR(100)"/>
            <column name="expiry_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
