            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_stationery_records"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_stationery_records_document_id"
                             foreignKeyName="fk_stationery_records_document"
                             referencedTableName="documents" referencedColumnNames="id"/>
            </column>
            <column name="item_name" type="VARCHAR(255)"/>
            <column name="quantity" type="NUMERIC(18,2)"/>
            <column name="unit" type="VARCHAR(50)"/>
            <column name="issue_date" type="DATE"/>
            <column name="employee_id" type="BIGINT">
                <constraints foreignKeyName="fk_stationery_records_employee"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="department" type="VARCHAR(255)"/>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="stationery_records" indexName="idx_stationery_records_employee_id">
            <column name="employee_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
