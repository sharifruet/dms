<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!-- Tender Notice -->
    <changeSet id="031-001-create-tender-notices" author="dms">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tender_notices"/></not>
        </preConditions>
        <comment>Create tender_notices table for TENDER_NOTICE typed documents</comment>
        <createTable tableName="tender_notices">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_tender_notices"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tender_notices_document_id"
                             foreignKeyName="fk_tender_notices_document"
                             referencedTableName="documents" referencedColumnNames="id"/>
            </column>
            <column name="tender_id" type="VARCHAR(100)"/>
            <column name="tender_type" type="VARCHAR(50)"/>
            <column name="tender_date" type="DATE"/>
            <column name="closing_date" type="DATE"/>
            <column name="publication_date" type="DATE"/>
            <column name="procurement_package_no" type="VARCHAR(255)"/>
            <column name="tender_valid_up_to" type="DATE"/>
            <column name="procurement_nature" type="VARCHAR(100)"/>
            <column name="procurement_type" type="VARCHAR(100)"/>
            <column name="procurement_description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="tender_notices" indexName="idx_tender_notices_tender_id">
            <column name="tender_id"/>
        </createIndex>
    </changeSet>

    <!-- Tender Document -->
    <changeSet id="031-002-create-tender-documents" author="dms">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="tender_documents"/></not>
        </preConditions>
        <comment>Create tender_documents table for TENDER_DOCUMENT typed documents</comment>
        <createTable tableName="tender_documents">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_tender_documents"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tender_documents_document_id"
                             foreignKeyName="fk_tender_documents_document"
                             referencedTableName="documents" referencedColumnNames="id"/>
            </column>
            <column name="tender_id" type="VARCHAR(100)"/>
            <column name="document_category" type="VARCHAR(100)"/>
            <column name="tender_type" type="VARCHAR(50)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="tender_documents" indexName="idx_tender_documents_tender_id">
            <column name="tender_id"/>
        </createIndex>
    </changeSet>

