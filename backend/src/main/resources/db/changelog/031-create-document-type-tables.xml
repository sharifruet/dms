    <!-- Bill Document (type-specific; separate from bill_headers) -->
    <changeSet id="031-007-create-bill-documents" author="dms">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="bill_documents"/></not>
        </preConditions>
        <comment>Create bill_documents table for BILL typed documents</comment>
        <createTable tableName="bill_documents">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_bill_documents"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_bill_documents_document_id"
                             foreignKeyName="fk_bill_documents_document"
                             referencedTableName="documents" referencedColumnNames="id"/>
            </column>
            <column name="vendor_name" type="VARCHAR(255)"/>
            <column name="invoice_number" type="VARCHAR(100)"/>
            <column name="invoice_date" type="DATE"/>
            <column name="fiscal_year" type="VARCHAR(20)"/>
            <column name="total_amount" type="NUMERIC(18,2)"/>
            <column name="tax_amount" type="NUMERIC(18,2)"/>
            <column name="net_amount" type="NUMERIC(18,2)"/>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex tableName="bill_documents" indexName="idx_bill_documents_invoice_number">
