        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="correspondences"/></not>
        </preConditions>
        <comment>Create correspondences table for CORRESPONDENCE typed documents</comment>
        <createTable tableName="correspondences">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_correspondences"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_correspondences_document_id"
                             foreignKeyName="fk_correspondences_document"
                             referencedTableName="documents" referencedColumnNames="id"/>
            </column>
            <column name="reference_no" type="VARCHAR(100)"/>
            <column name="subject" type="VARCHAR(500)"/>
            <column name="letter_date" type="DATE"/>
            <column name="from_party" type="VARCHAR(255)"/>
