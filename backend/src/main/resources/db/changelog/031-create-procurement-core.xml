<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <!--
      Procurement lifecycle core: the package (root aggregate), its stage rows,
      and the polymorphic document link table.
      See requirements/procurement-lifecycle-workflow-requirements.md sections 2 and 3.
    -->

    <changeSet id="031-001" author="dms">
        <comment>Create procurement_package - root entity, key = package_number (REQ-L2)</comment>
        <createTable tableName="procurement_package">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_procurement_package"/>
            </column>
            <!-- One APP line may produce several packages / lots (client answer Q-1) -->
            <column name="app_line_id" type="BIGINT"/>
            <column name="package_number" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_package_number"/>
            </column>
            <column name="lot_number" type="VARCHAR(50)"/>
            <column name="lot_description" type="VARCHAR(500)"/>
            <column name="package_description" type="TEXT"/>
            <column name="approving_authority" type="VARCHAR(255)"/>
            <column name="price_lac_bdt" type="NUMERIC(18,2)"/>
            <column name="fiscal_year" type="INTEGER"/>
            <column name="department" type="VARCHAR(255)"/>
            <column name="current_stage" type="SMALLINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="procurement_package" baseColumnNames="app_line_id"
                                 constraintName="fk_package_app_line"
                                 referencedTableName="app_lines" referencedColumnNames="id"
                                 onDelete="SET NULL"/>
        <createIndex tableName="procurement_package" indexName="idx_package_number">
            <column name="package_number"/>
        </createIndex>
        <createIndex tableName="procurement_package" indexName="idx_package_stage_status">
            <column name="current_stage"/>
            <column name="status"/>
        </createIndex>
        <rollback>
            <dropTable tableName="procurement_package"/>
        </rollback>
    </changeSet>

    <changeSet id="031-002" author="dms">
        <comment>Create package_stage - one row per stage, drives the stage gates (WF-01..WF-10)</comment>
        <createTable tableName="package_stage">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_package_stage"/>
            </column>
            <column name="package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="stage_code" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="NOT_STARTED">
                <constraints nullable="false"/>
            </column>
            <column name="is_applicable" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="not_applicable_reason" type="TEXT"/>
            <column name="entered_at" type="TIMESTAMP"/>
            <column name="completed_at" type="TIMESTAMP"/>
            <column name="completed_by" type="BIGINT"/>
            <column name="rework_reason" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="package_stage" baseColumnNames="package_id"
                                 constraintName="fk_stage_package"
                                 referencedTableName="procurement_package" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="package_stage" columnNames="package_id, stage_code"
                             constraintName="uk_package_stage"/>
        <rollback>
            <dropTable tableName="package_stage"/>
        </rollback>
    </changeSet>

    <changeSet id="031-003" author="dms">
        <comment>Create document_link - every document resolves to a package (REQ-L1, REQ-P1)</comment>
        <createTable tableName="document_link">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_document_link"/>
            </column>
            <column name="document_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="BIGINT"/>
            <column name="package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="contract_id" type="BIGINT"/>
            <column name="stage_code" type="SMALLINT">
                <constraints nullable="false"/>
            </column>
            <column name="doc_role" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="is_mandatory" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="is_applicable" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="link_origin" type="VARCHAR(20)" defaultValue="STAGE_CONTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="document_link" baseColumnNames="document_id"
                                 constraintName="fk_doclink_document"
                                 referencedTableName="documents" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="document_link" baseColumnNames="package_id"
                                 constraintName="fk_doclink_package"
                                 referencedTableName="procurement_package" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addUniqueConstraint tableName="document_link"
                             columnNames="document_id, entity_type, entity_id, doc_role"
                             constraintName="uk_document_link"/>
        <createIndex tableName="document_link" indexName="idx_doclink_package_stage">
            <column name="package_id"/>
            <column name="stage_code"/>
        </createIndex>
        <createIndex tableName="document_link" indexName="idx_doclink_entity">
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
        <rollback>
            <dropTable tableName="document_link"/>
        </rollback>
    </changeSet>

    <changeSet id="031-004" author="dms">
        <comment>Add package context to documents for search (REQ-L9)</comment>
        <addColumn tableName="documents">
            <column name="package_id" type="BIGINT"/>
            <column name="contract_id" type="BIGINT"/>
            <column name="stage_code" type="SMALLINT"/>
        </addColumn>
        <createIndex tableName="documents" indexName="idx_documents_package">
            <column name="package_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="documents" indexName="idx_documents_package"/>
            <dropColumn tableName="documents" columnName="package_id"/>
            <dropColumn tableName="documents" columnName="contract_id"/>
            <dropColumn tableName="documents" columnName="stage_code"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
